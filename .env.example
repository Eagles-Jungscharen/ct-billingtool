# ChurchTool Billing Tool - Environment Variables
# Copy this file to .env.local and fill in the values

# ============================================
# FRONTEND (Vite) - Variables must start with VITE_
# ============================================

# OIDC Authentication
VITE_OIDC_AUTHORITY=                      # ChurchTool IDP Base URL (e.g., https://authentication.acme.com/api/oidc)
VITE_OIDC_CLIENT_ID=                      # OIDC Client ID of the registered app
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback      # OAuth callback URL
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173       # Post-logout redirect URL

# Backend API
VITE_API_BASE_URL=http://localhost:7072   # Azure Functions Base URL (local development port: 7072)

# ============================================
# BACKEND (Azure Functions)
# ============================================

# Azure Functions Runtime
AzureWebJobsStorage=UseDevelopmentStorage=true                  # Use Azurite for local development
FUNCTIONS_WORKER_RUNTIME=dotnet-isolated                        # .NET isolated worker process
APPLICATIONINSIGHTS_CONNECTION_STRING=                          # Application Insights connection string (optional for local dev)

# ChurchTool Integration
CHURCHTOOL_URL=                                                 # ChurchTool API base URL
OIDC_AUTHORITY_URL=                                             # Same as VITE_OIDC_AUTHORITY (without /api/oidc suffix if different)
CHURCHTOOL_IDP_BASE_URL=                                        # ChurchTool IDP function base URL
CHURCHTOOL_IDP_FUNCTION_KEY=                                    # Function key for ChurchTool IDP authentication
CHURCHTOOL_ADMIN_GROUP_ID=                                      # ChurchTool group ID for admin users

# Storage
CHURCHTOOL_IDP_STORAGE_CONNECTION_STRING=                       # Must point to oicd-identity-provider Table Storage

# CORS (configured in local.settings.json for Azure Functions)
# CORS=http://localhost:5173
# CORSCredentials=true

# ============================================
# NOTES
# ============================================
# - For local development, use Azurite for Azure Storage emulation (Table Storage, Blob Storage, Queue Storage)
# - Frontend runs on port 5173 (Vite default)
# - Backend runs on port 7071 (Azure Functions)
# - CORS is configured in backend's local.settings.json to allow requests from http://localhost:5173
