              ]
            }
          ],
          "outputs": {
            "profileName": {
              "type": "string",
              "value": "[parameters('cdnProfileName')]"
            },
            "endpointName": {
              "type": "string",
              "value": "[parameters('endpointName')]"
            },
            "endpointHostName": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Cdn/profiles/endpoints', parameters('cdnProfileName'), parameters('endpointName')), '2023-05-01').hostName]"
            },
            "customDomainResourceName": {
              "type": "string",
              "value": "[if(empty(parameters('customDomainName')), '', replace(parameters('customDomainName'), '.', '-'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', format('storage-static-website-{0}', parameters('environmentName')))]"
      ]
    }
  ],
  "outputs": {
    "frontendStorageAccountName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', format('storage-static-website-{0}', parameters('environmentName'))), '2025-04-01').outputs.storageAccountName.value]"
    },
    "frontendWebsiteUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', format('storage-static-website-{0}', parameters('environmentName'))), '2025-04-01').outputs.primaryWebEndpoint.value]"
    },
    "dataStorageAccountName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', format('storage-data-{0}', parameters('environmentName'))), '2025-04-01').outputs.storageAccountName.value]"
    },
    "functionAppName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', format('function-app-{0}', parameters('environmentName'))), '2025-04-01').outputs.functionAppName.value]"
    },
    "functionAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Resources/deployments', format('function-app-{0}', parameters('environmentName'))), '2025-04-01').outputs.defaultHostName.value)]"
    },
    "applicationInsightsName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', format('monitoring-{0}', parameters('environmentName'))), '2025-04-01').outputs.appInsightsName.value]"
    },
    "cdnEndpointHostName": {
      "type": "string",
      "value": "[if(parameters('enableCdn'), reference(resourceId('Microsoft.Resources/deployments', format('cdn-{0}', parameters('environmentName'))), '2025-04-01').outputs.endpointHostName.value, '')]"
    }
  }
}