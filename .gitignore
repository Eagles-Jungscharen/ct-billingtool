# ============================================
# ChurchTool Billing Tool - Monorepo .gitignore
# ============================================

# ============================================
# Environment Variables
# ============================================
.env
.env.local
.env.*.local
.env.production
*.local

# ============================================
# Node.js / npm
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# Build Outputs
# ============================================
# Frontend
packages/frontend/dist/
packages/frontend/dist-ssr/

# Shared
packages/shared/dist/

# Backend (.NET)
packages/backend/bin/
packages/backend/obj/
packages/backend/publish/

# ============================================
# .NET Specific
# ============================================
*.user
.vs/
.vscode/
*.suo
*.njsproj
*.sln.docstates

# ============================================
# Azure Functions
# ============================================
packages/backend/local.settings.json
.azurite/
__blobstorage__/
__queuestorage__/
__azurite_db*__.json
AzuriteConfig

# ============================================
# Logs
# ============================================
logs/
*.log

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============================================
# IDEs and Editors
# ============================================
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Visual Studio
.vs/
*.user
*.userosscache
*.sln.docstates

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~
.netrwhist

# ============================================
# Testing
# ============================================
coverage/
*.coverage
.nyc_output/
.jest/

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ============================================
# Docker
# ============================================
docker-compose.override.yml

# ============================================
# Miscellaneous
# ============================================
*.ntvs*
*.sw?
